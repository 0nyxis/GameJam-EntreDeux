# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
# Recommended: add any editor/OS/tool-specific ignore rules from the Global/ templates as needed.
# See: https://github.com/github/gitignore/tree/main/Global
#
.utmp/
EntreDeux/[Ll]ibrary/
EntreDeux/[Tt]emp/
EntreDeux/[Oo]bj/
EntreDeux/[Bb]uild/
EntreDeux/[Bb]uilds/
EntreDeux/[Ll]ogs/
EntreDeux/[Uu]ser[Ss]ettings/
*.log

# Memory Profiler generated files
# MemoryCaptures can get excessive in size
# They also could contain extremely sensitive data
EntreDeux/[Mm]emory[Cc]aptures/

# Recordings can get excessive in size
EntreDeux/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# EntreDeux/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
EntreDeux/[Aa]ssets/Plugins/Editor/JetBrains*
# Jetbrains Rider personal-layer settings
*.DotSettings.user

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.vsconfig

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Mono auto generated files
.dirstamp
mono_crash.*
tmpinst-dir.stamp

# Builds
EntreDeux/*_BackUpThisFolder_ButDontShipItWithYourGame/
EntreDeux/*_BurstDebugInformation_DoNotShip/
*.apk
*.aab
*.obb
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# Blender generated backup files
EntreDeux/[Aa]ssets/**/*.blend1
EntreDeux/[Aa]ssets/**/*.blend1.meta

# TouchDesigner generated cache files
EntreDeux/[Aa]ssets/**/TDImportCache/
EntreDeux/[Aa]ssets/**/TDImportCache.meta

# Unity Crash Recovery generated files
EntreDeux/[Aa]ssets/_Recovery/
EntreDeux/[Aa]ssets/_Recovery.meta

# Addressables default ignores, before user customizations
# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
# EntreDeux/Assets/AddressableAssetsData/OSX/addressables_content_state.bin
EntreDeux/[Aa]ssets/AddressableAssetsData/*/addressables_content_state.bin
EntreDeux/[Aa]ssets/AddressableAssetsData/*/addressables_content_state.bin.meta
EntreDeux/[Aa]ssets/AddressableAssetsData/link.xml
EntreDeux/[Aa]ssets/AddressableAssetsData/link.xml.meta
EntreDeux/[Aa]ssets/Addressables_Temp/
EntreDeux/[Aa]ssets/Addressables_Temp.meta
EntreDeux/[Aa]ssets/StreamingAssets/aa/
EntreDeux/[Aa]ssets/StreamingAssets/aa.meta
EntreDeux/ServerData/

# EDM4U generated files
EntreDeux/[Aa]ssets/GeneratedLocalRepo/
EntreDeux/[Aa]ssets/GeneratedLocalRepo.meta

# Android Gradle generated files
EntreDeux/[Aa]ssets/Plugins/Android/**/*.gradle.backup*
EntreDeux/[Aa]ssets/Plugins/Android/**/local.properties

# Test Framework generated files
EntreDeux/[Aa]ssets/Resources/PerformanceTestRunInfo.json
EntreDeux/[Aa]ssets/Resources/PerformanceTestRunInfo.json.meta
EntreDeux/[Aa]ssets/Resources/PerformanceTestRunSettings.json
EntreDeux/[Aa]ssets/Resources/PerformanceTestRunSettings.json.meta
EntreDeux/[Aa]ssets/InitTestScene*.unity
EntreDeux/[Aa]ssets/InitTestScene*.unity.meta

# Visual Scripting auto-generated files
EntreDeux/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers/
EntreDeux/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta
EntreDeux/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
EntreDeux/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta

# UI Toolkit auto generated files
EntreDeux/UIElementsSchema/

# Auto-generated cache in Assets folder
EntreDeux/[Aa]ssets/[Ss]ceneDependencyCache*
